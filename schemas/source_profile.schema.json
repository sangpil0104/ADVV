{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADVV source preservation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "must_preserve", "uncertain"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1500, "pattern": "\\S"},
    "must_preserve": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}
    },
    "uncertain": {"type": "boolean"}
  }
}
