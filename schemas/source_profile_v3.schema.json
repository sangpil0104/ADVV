{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADVV source preservation profile v3 (with subjects and parts)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "must_preserve",
    "subjects",
    "parts",
    "uncertain"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "pattern": "\\S"
    },
    "must_preserve": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(['-][a-z0-9]+)*( [a-z0-9]+(['-][a-z0-9]+)*){0,4}$"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(['-][a-z0-9]+)*( [a-z0-9]+(['-][a-z0-9]+)*){0,4}$"
      }
    },
    "uncertain": {
      "type": "boolean"
    }
  }
}
